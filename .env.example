
# ==========================================
# Application Configuration
# ==========================================
APP_NAME=RealGrowth Data Service
APP_ENV=development
PORT=8000

# ==========================================
# External API Credentials
# ==========================================
APOLLO_API_KEY=your_apollo_api_key
CLAY_API_KEY=your_clay_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ==========================================
# NestJS Backend Configuration
# ==========================================
NESTJS_BASE_URL=http://localhost:3000
PROSPECT_PROCESSING_API_KEY=your_prospect_processing_api_key

# ==========================================
# MongoDB Configuration
# ==========================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=realgrowth
MONGODB_PROSPECT_COLLECTION=prospects
MONGODB_CONNECTION_COLLECTION=prospect_connections
MONGODB_CONVERSATION_COLLECTION=prospect_conversations

# ==========================================
# RabbitMQ Configuration
# ==========================================
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_SCORING_QUEUE=prospect-scoring

# ==========================================
# Cloudinary Configuration
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=realgrowth/conversations

# ==========================================
# Hugging Face OCR Configuration
# ==========================================
HUGGINGFACE_API_TOKEN=your_huggingface_api_token
HUGGINGFACE_OCR_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# ==========================================
# Groq AI Configuration
# ==========================================
GROQ_API_KEY=your_groq_api_key

# Groq OCR Fallback
GROQ_OCR_MODEL=qwen/qwen3.8-27b

# Groq Conversation Analysis
GROQ_LLM_MODEL=openai/gpt-oss-120b

# ==========================================
# Tesseract OCR Configuration
# ==========================================
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANGUAGE=eng
TESSERACT_PSM=11
TESSERACT_OEM=3
